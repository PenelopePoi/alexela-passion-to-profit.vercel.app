# ============================================================================
# XELA Creative Branding Studio — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# Vite exposes only variables prefixed with VITE_ to client-side code.
# .env.local is gitignored — never commit real keys.
# ============================================================================

# ─── Firebase (client-side safe — these are public project identifiers) ──────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Google Gemini AI ────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
VITE_API_KEY=

# ─── Stripe (publishable key only — secret key stays server-side) ────────────
# Get your publishable key at https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=

# ─── Server-Side Only (Vercel Environment Variables) ────────────────────────
# These are NOT prefixed with VITE_ — they are only available in /api/ routes.
# Set these in the Vercel dashboard: Settings → Environment Variables
#
# Stripe secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Gemini API key for server-side AI generation
GEMINI_API_KEY=
