{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/financial/:action", "destination": "/api/financial?action=:action" },
    { "source": "/api/invoice/:action", "destination": "/api/invoice?action=:action" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
